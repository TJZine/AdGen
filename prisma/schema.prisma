datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

model Project {
  id          String   @id @default(uuid())
  name        String
  type        String
  contentJson String
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Template {
  id           String   @id @default(uuid())
  name         String
  layoutFamily String
  contentJson  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Asset {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("image")
  filePath    String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  focalPointX Float    @default(0.5)
  focalPointY Float    @default(0.5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
